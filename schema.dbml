//////////////////////////////////////
// Enums
//////////////////////////////////////

Enum user_role {
  trainer
  athlete
}

Enum biological_sex {
  male
  female
  other
}

Enum activity_level {
  sedentary
  lightly_active
  moderately_active
  very_active
  extremely_active
}

Enum invitation_status {
  pending   // athlete sent the invitation, trainer has not answered
  active    // trainer accepted
  declined  // trainer rejected
  ended     // relationship terminated later
}

//////////////////////////////////////
// Identity (profile merged into users)
//////////////////////////////////////

Table users {
  id integer [pk, increment]
  email varchar [unique, not null]
  password_hash varchar [not null]
  full_name varchar [not null]
  role user_role [not null, default: 'athlete']
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  // profile data (nullable: mostly relevant for athletes)
  date_of_birth date
  sex biological_sex
  height_cm decimal(5,2)
  activity_level activity_level [default: 'moderately_active']
}

Table trainer_athletes {
  id integer [pk, increment]
  trainer_id integer [not null, ref: > users.id]
  athlete_id integer [not null, ref: > users.id]
  status invitation_status [not null, default: 'pending']
  invited_at timestamp [not null, default: `now()`]
  responded_at timestamp
  ended_at timestamp

  indexes {
    (trainer_id, athlete_id) [unique]
  }
}

//////////////////////////////////////
// Training: plan -> workouts -> exercises
//////////////////////////////////////

// Catalog of exercises (one row per exercise, reused everywhere)
Table exercises {
  id integer [pk, increment]
  name varchar [not null]
  description varchar
}

Table workout_plans {
  id integer [pk, increment]
  name varchar [not null]
  description varchar
  created_by integer [not null, ref: > users.id]   // athlete or trainer
  athlete_id integer [not null, ref: > users.id]   // who the plan is for
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table workouts {
  id integer [pk, increment]
  workout_plan_id integer [not null, ref: > workout_plans.id]
  name varchar [not null]
  day_number integer [not null]

  indexes {
    (workout_plan_id, day_number)
  }
}

// Exercises inside a workout, with the planned number of sets
Table workout_exercises {
  id integer [pk, increment]
  workout_id integer [not null, ref: > workouts.id]
  exercise_id integer [not null, ref: > exercises.id]
  sets integer [not null]
  reps integer          // optional target
  weight_kg decimal(6,2) // optional target
  order_index integer

  indexes {
    (workout_id, order_index)
  }
}

//////////////////////////////////////
// Logging
//////////////////////////////////////

Table workout_logs {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  workout_id integer [not null, ref: > workouts.id] // plan is reachable via workouts
  logged_at timestamp [not null, default: `now()`]
  notes varchar
}

Table workout_log_sets {
  id integer [pk, increment]
  workout_log_id integer [not null, ref: > workout_logs.id]
  exercise_id integer [not null, ref: > exercises.id]
  set_number integer [not null]
  weight_kg decimal(6,2) [not null]
  reps integer [not null]

  indexes {
    (workout_log_id, exercise_id, set_number) [unique]
  }
}
